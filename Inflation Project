#Split into Training and Testing. Using standard 80/20 split. 

train_indices <- sample(1:nrow(USA), size = 0.8 * nrow(USA))

train_data <- USA[train_indices, ]
test_data <- USA[-train_indices, ]

#Modelling & Predictions

Model_One <- lm(Inflation ~ InterestRates + UnemploymentRate + RetailTrade + PPI + WageGrowth, data = USA)
summary(Model_One)  # Fixed capitalization

# Predictions for linear regression (no type argument needed)
predictions <- predict(Model_One, newdata = test_data)

# Create a dataframe with predictions
Inflation_results <- data.frame(
  Date = test_data$Date,
  Actual = test_data$Inflation,
  Predicted = predictions,
  Residual = test_data$Inflation - predictions
)

# View first few rows
head(Inflation_results)

# Model evaluation metrics
mae <- mean(abs(Inflation_results$Residual))
rmse <- sqrt(mean(Inflation_results$Residual^2))
r_squared <- cor(Inflation_results$Actual, Inflation_results$Predicted)^2

cat("Mean Absolute Error:", mae, "\n")
cat("Root Mean Squared Error:", rmse, "\n")
cat("R-squared on test set:", r_squared, "\n")





